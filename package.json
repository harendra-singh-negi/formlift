{
  "name": "formlift",
  "version": "0.1.0",
  "description": "Turn any PDF into a fillable web form: auto-detect fields, drag-and-drop builder, conditional logic, validation, fill-in UI and a completed-PDF generator. React UI + framework-agnostic core.",
  "keywords": [
    "pdf",
    "pdf-form",
    "form-builder",
    "fillable-pdf",
    "pdf-fields",
    "react",
    "pdfjs",
    "pdf-lib",
    "conditional-logic",
    "document-forms"
  ],
  "license": "MIT",
  "author": "Harendra Singh Negi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harendra-singh-negi/formlift.git"
  },
  "homepage": "https://harendra-singh-negi.github.io/formlift/",
  "bugs": {
    "url": "https://github.com/harendra-singh-negi/formlift/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "npm run build && vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo:build": "npm run build && vite build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": ">=4.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "pdf-lib": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^0.500.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
